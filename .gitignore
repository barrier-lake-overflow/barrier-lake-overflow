# 原始資料進版控，中間產物與影像不進

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 虛擬環境 ──────────────────────────────────────────
.venv/
venv/
env/

# ── 資料 ──────────────────────────────────────────────
# 原始清冊等小型 CSV 要進版控，其餘一律排除
data/raw/*
!data/raw/.gitkeep
!data/raw/*.csv
# 小型 JSON：hotspots.json（每日排程必備）、replay_manifest.json、external_evidence_research.json
!data/raw/*.json

# 風險模型快照（小檔案，非時序矩陣）也要進版控
!data/raw/risk/
!data/raw/risk/*.csv
!data/raw/risk/*.txt
!data/raw/risk/*.json

# 事件研判情境設定（地點＋影像期別）
!data/raw/scenarios/
!data/raw/scenarios/*.json

# 中繼產物可重新產生，不進版控
data/derived/*
!data/derived/final_*.json
data/interim/
data/cache/

# ── 衛星影像與地理資料 ────────────────────────────────
# 單景 Sentinel-1 動輒數 GB，GitHub 單檔上限 100 MB
*.SAFE/
*.tif
*.tiff
*.img
*.dim
*.data/
*.nc
*.hdf
*.zip
*.tar.gz

# DEM 與大型向量圖資
*.asc
*.shp
*.shx
*.dbf
*.gpkg
*.geoparquet

# ── 例外：前端讀取的產生物 ────────────────────────────
# 前端沒有 build step，產生的資料檔要進版控
!code/dashboard/data/lakes.js
!code/dashboard/data/risk.js

# ── 憑證與金鑰 ────────────────────────────────────────
# CWA API key、CDSE 帳密、TDX client secret 一律不得進版控
.env
.env.*
*.key
*.pem
credentials.json
secrets.yaml

# ── 編輯器與作業系統 ──────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ── Node（若之後前端加上建置工具）─────────────────────
node_modules/
package-lock.json

# 馬太鞍溪 SAR 驗證：影像與結果一起進版控，方便直接取用
!data/raw/sentinel1/
!data/raw/sentinel1/*.tif
!data/raw/sentinel2/
!data/raw/sentinel2/*.tif
!data/raw/sentinel2/*.csv

# disclosure
docs/disclosure.md

# 每日自動更新：執行鎖、日誌（影像 *.tif 已在上方忽略）
data/live/.lock
data/live/logs/

# Netlify 建置時複製進發布目錄的證據圖（來源在 docs/evidence/）
code/dashboard/docs/

# GCP 服務帳號金鑰（等同密碼，絕不進版控；設定成 GitHub Secret 後就刪掉本機檔案）
/ossint2026-*.json
*service-account*.json
